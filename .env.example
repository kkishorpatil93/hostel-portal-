# Flask Configuration
FLASK_APP=run.py
FLASK_ENV=development
FLASK_DEBUG=1
SECRET_KEY=generate-a-strong-secret-key-min-32-chars-for-production

# Database URL
# SQLite locally: sqlite:///instance/staynest.db
# PostgreSQL in production: postgresql+psycopg2://user:password@localhost:5432/staynest
DATABASE_URL=sqlite:///instance/staynest.db

# Regional Defaults
CURRENCY_SYMBOL=₹
CURRENCY_CODE=INR
TIMEZONE=Asia/Kolkata
DATE_FORMAT=%d-%b-%Y

# Security & Uploads
SESSION_COOKIE_SECURE=False
MAX_CONTENT_LENGTH=10485760  # 10 MB
UPLOAD_FOLDER=app/static/uploads
PRIVATE_UPLOAD_FOLDER=instance/private_uploads

# Operational Defaults
DEFAULT_RENT_DUE_DAY=5
DEFAULT_GRACE_DAYS=3
DEFAULT_NOTICE_PERIOD_DAYS=30
DEFAULT_SECURITY_DEPOSIT_MONTHS=1

# Email Settings (Optional / Dev Console by default)
MAIL_SERVER=localhost
MAIL_PORT=8025
MAIL_USE_TLS=False
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_DEFAULT_SENDER=noreply@staynest.local

# Payment Gateway (Optional / Sandbox)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# AI Assistant (Optional)
ANTHROPIC_API_KEY=
